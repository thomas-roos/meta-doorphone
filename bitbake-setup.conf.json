    "bitbake-setup": {
        "configurations": [
            {
                "name": "doorphone",
                "description": "SIP doorphone configuration for Raspberry Pi 64",
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-yocto/meta-poky",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-filesystems",
                    "meta-rauc",
                    "meta-rauc-community/meta-rauc-raspberrypi",
                    "meta-raspberrypi",
                    "meta-aws",
                    "meta-bc"
                ],
                "bb-layers-file-relative": [
                    "meta-doorphone"
                ],
				"oe-fragments": ["core/yocto/sstate-mirror-cdn", "machine/raspberrypi-armv8", "doorphone/doorphone"],
                "oe-fragments-one-of": {
                    "distro": {
                        "description": "Distribution variants",
                        "options": ["distro/poky", "distro/poky-altcfg"]
                    }
                }
            }
        ]
    }
